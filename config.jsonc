{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/home/trixie/.config/fastfetch/texto.txt",
        "padding": {
            "top": 2,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "separator": "38;2;108;112;134"
        },
        "percent": {
            "type": [
                "bar"
            ],
            "color": {
                "green": "38;2;166;227;161",
                "yellow": "38;2;249;226;175",
                "red": "38;2;243;139;168"
            }
        },
        "bar": {
            "char": {
                "elapsed": "▰",
                "total": "▱"
            },
            "width": 10,
            "border": {
                "left": "",
                "right": ""
            },
            "color": {
                "total": "38;2;88;91;112"
            }
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "  {#1;38;2;203;166;247}t{#1;38;2;199;169;244}r{#1;38;2;196;173;242}i{#1;38;2;192;177;240}x{#1;38;2;189;181;238}i{#1;38;2;185;184;236}e{#1;38;2;182;188;234} {#1;38;2;178;192;232}󰊠{#1;38;2;175;196;230} {#1;38;2;172;199;227}C{#1;38;2;168;203;225}o{#1;38;2;165;207;223}o{#1;38;2;161;211;221}l{#1;38;2;158;214;219}D{#1;38;2;154;218;217}o{#1;38;2;151;222;215}g{#1;38;2;148;226;213}s"
        },
        {
            "type": "custom",
            "format": "{#38;2;137;180;250}╭{#38;2;136;180;249}─{#38;2;135;181;249} {#38;2;135;181;248}S{#38;2;134;182;248}I{#38;2;133;182;247}S{#38;2;133;183;247}T{#38;2;132;184;247}E{#38;2;131;184;246}M{#38;2;131;185;246}A{#38;2;130;185;245} {#38;2;130;186;245}─{#38;2;129;186;244}─{#38;2;128;187;244}─{#38;2;128;188;244}─{#38;2;127;188;243}─{#38;2;126;189;243}─{#38;2;126;189;242}─{#38;2;125;190;242}─{#38;2;124;190;241}─{#38;2;124;191;241}─{#38;2;123;192;241}─{#38;2;123;192;240}─{#38;2;122;193;240}─{#38;2;121;193;239}─{#38;2;121;194;239}─{#38;2;120;194;238}─{#38;2;119;195;238}─{#38;2;119;196;238}─{#38;2;118;196;237}─{#38;2;117;197;237}─{#38;2;117;197;236}─{#38;2;116;198;236}─{#38;2;116;199;236}─"
        },
        {
            "type": "os",
            "key": "│ 󰣇  OS      ",
            "keyColor": "38;2;137;180;250"
        },
        {
            "type": "host",
            "key": "│ 󰌢  Host    ",
            "keyColor": "38;2;116;199;236"
        },
        {
            "type": "kernel",
            "key": "│ 󰒋  Kernel  ",
            "keyColor": "38;2;137;180;250",
            "format": "{2}"
        },
        {
            "type": "uptime",
            "key": "│ 󰅐  Uptime  ",
            "keyColor": "38;2;116;199;236"
        },
        {
            "type": "packages",
            "key": "│ 󰏖  Pkgs    ",
            "keyColor": "38;2;137;180;250"
        },
        {
            "type": "shell",
            "key": "│   Shell   ",
            "keyColor": "38;2;116;199;236"
        },
        {
            "type": "custom",
            "format": "{#38;2;203;166;247}├{#38;2;204;166;246}─{#38;2;205;167;246} {#38;2;206;168;245}E{#38;2;208;169;245}N{#38;2;209;170;244}T{#38;2;210;171;244}O{#38;2;211;171;243}R{#38;2;213;172;243}N{#38;2;214;173;242}O{#38;2;215;174;242} {#38;2;217;175;241}─{#38;2;218;176;241}─{#38;2;219;177;240}─{#38;2;220;177;240}─{#38;2;222;178;239}─{#38;2;223;179;239}─{#38;2;224;180;238}─{#38;2;225;181;238}─{#38;2;227;182;237}─{#38;2;228;182;237}─{#38;2;229;183;236}─{#38;2;231;184;236}─{#38;2;232;185;235}─{#38;2;233;186;235}─{#38;2;234;187;234}─{#38;2;236;188;234}─{#38;2;237;188;233}─{#38;2;238;189;233}─{#38;2;239;190;232}─{#38;2;241;191;232}─{#38;2;242;192;231}─{#38;2;243;193;231}─{#38;2;245;194;231}─"
        },
        {
            "type": "wm",
            "key": "│ 󰪇  WM      ",
            "keyColor": "38;2;203;166;247"
        },
        {
            "type": "de",
            "key": "│ 󰍹  DE      ",
            "keyColor": "38;2;245;194;231"
        },
        {
            "type": "display",
            "key": "│ 󰍹  Pantalla",
            "keyColor": "38;2;203;166;247",
            "compactType": "original",
            "format": "{1}x{2} @ {3}Hz"
        },
        {
            "type": "terminal",
            "key": "│   Term    ",
            "keyColor": "38;2;245;194;231"
        },
        {
            "type": "terminalfont",
            "key": "│ 󰛖  Fuente  ",
            "keyColor": "38;2;203;166;247"
        },
        {
            "type": "localip",
            "key": "│ 󰩟  IP      ",
            "keyColor": "38;2;245;194;231"
        },
        {
            "type": "command",
            "key": "│ 󰝚  Suena   ",
            "keyColor": "38;2;203;166;247",
            "text": "s=$(playerctl metadata --format '{{artist}} - {{title}}' 2>/dev/null); [ -z \"$s\" ] && s='silencio'; echo \"$s\" | awk '{ if (length($0)>24) print substr($0,1,24)\"…\"; else print }'"
        },
        {
            "type": "custom",
            "format": "{#38;2;166;227;161}├{#38;2;165;226;162}─{#38;2;164;226;164} {#38;2;164;226;165}H{#38;2;163;226;167}A{#38;2;163;226;168}R{#38;2;162;226;170}D{#38;2;162;226;172}W{#38;2;161;226;173}A{#38;2;161;226;175}R{#38;2;160;226;176}E{#38;2;160;226;178} {#38;2;159;226;179}─{#38;2;158;226;181}─{#38;2;158;226;183}─{#38;2;157;226;184}─{#38;2;157;226;186}─{#38;2;156;226;187}─{#38;2;156;226;189}─{#38;2;155;226;190}─{#38;2;155;226;192}─{#38;2;154;226;194}─{#38;2;154;226;195}─{#38;2;153;226;197}─{#38;2;152;226;198}─{#38;2;152;226;200}─{#38;2;151;226;201}─{#38;2;151;226;203}─{#38;2;150;226;205}─{#38;2;150;226;206}─{#38;2;149;226;208}─{#38;2;149;226;209}─{#38;2;148;226;211}─{#38;2;148;226;213}─"
        },
        {
            "type": "cpu",
            "key": "│ 󰻠  CPU     ",
            "keyColor": "38;2;166;227;161",
            "format": "{1} ({4}) @ {7}"
        },
        {
            "type": "gpu",
            "key": "│ 󰢮  GPU     ",
            "keyColor": "38;2;148;226;213",
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": "│ 󰍛  RAM     ",
            "keyColor": "38;2;166;227;161",
            "format": "{percentage-bar} {used} / {total}"
        },
        {
            "type": "battery",
            "key": "│ 󰁹  Batería ",
            "keyColor": "38;2;148;226;213",
            "format": "{capacity-bar} {status}"
        },
        {
            "type": "disk",
            "key": "╰ 󰋊  Disco   ",
            "keyColor": "38;2;166;227;161",
            "folders": "/",
            "format": "{size-percentage-bar} {size-used} / {size-total}"
        },
        {
            "type": "command",
            "text": "h=$(date +%H); if [ \"$h\" -lt 12 ]; then g='buenos días'; elif [ \"$h\" -lt 19 ]; then g='buenas tardes'; else g='buenas noches'; fi; set -- dom lun mar mié jue vie sáb; shift $(date +%w); d=$1; set -- ene feb mar abr may jun jul ago sep oct nov dic; shift $(( $(date +%-m) - 1 )); echo \"$g · $d $(date +%-d) $1\"",
            "key": " ❯",
            "keyColor": "38;2;166;227;161"
        },
        {
            "type": "custom",
            "format": " {#38;2;203;166;247}● {#38;2;245;194;231}● {#38;2;250;179;135}● {#38;2;249;226;175}● {#38;2;166;227;161}● {#38;2;148;226;213}● {#38;2;116;199;236}● {#38;2;137;180;250}● {#38;2;180;190;254}●"
        }
    ]
}
